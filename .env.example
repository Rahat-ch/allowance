# NEAR accounts (keys live in ~/.near-credentials/<network>, never in this repo)
NEAR_NETWORK=testnet
OWNER_ACCOUNT_ID=
RELAYER_ACCOUNT_ID=
PAYEE_ACCOUNT_ID=

# `pnpm --filter deploy run allowance` (packages/deploy). Settings come from a JSON
# config (copy packages/deploy/allowance.config.example.json); these override it.
# Config file path (default: allowance.config.json at the repo root, git-ignored)
ALLOWANCE_CONFIG=
# Sub-account name: the Allowance is created as <ALLOWANCE_NAME>.<OWNER_ACCOUNT_ID>.
# Every deploy needs a new name; an existing Allowance is never touched.
ALLOWANCE_NAME=

# Written by the deploy
ALLOWANCE_ACCOUNT_ID=
# The Agent's function-call key (request_spend only), ~/.near-credentials/<network>/agent-<allowance>.json
AGENT_KEY_FILE=
