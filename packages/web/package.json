{
  "name": "web",
  "private": true,
  "type": "module",
  "description": "Owner web page: a static single-page app where the Owner signs in with a NEAR wallet to approve or reject Pending spends, Pause, unpause or Revoke, and watch the budget.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "typecheck": "tsc --noEmit",
    "sandbox": "tsx scripts/sandbox.ts"
  },
  "dependencies": {
    "@near-js/accounts": "2.5.1",
    "@near-js/crypto": "2.5.1",
    "@near-js/providers": "2.5.1",
    "@near-js/signers": "2.5.1",
    "@near-js/transactions": "2.5.1",
    "@near-js/types": "2.5.1",
    "@near-wallet-selector/core": "10.1.4",
    "@near-wallet-selector/intear-wallet": "10.1.4",
    "@near-wallet-selector/meteor-wallet": "10.1.4",
    "@near-wallet-selector/my-near-wallet": "10.1.4",
    "buffer": "6.0.3",
    "near-api-js": "6.5.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "sandbox": "workspace:*",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
